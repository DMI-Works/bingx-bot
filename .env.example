# BingX API Credentials (live)
BINGX_API_KEY=your_api_key_here
BINGX_API_SECRET=your_api_secret_here

# Опционально: testnet-ключи (VST) администратора, при старте импортируются в его
# профиль. Без них ключи вводятся в Mini App: боевые ключи в testnet не используются.
BINGX_API_KEY_TESTNET=
BINGX_API_SECRET_TESTNET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

WEBAPP_URL=https://your-webapp-url-here

MONGO_URI=mongo_uri_here
MONGO_DB_NAME=trading_bot

# Багатокористувацький режим
# Ключ шифрування API-ключів користувачів (Fernet). БЕЗ НЬОГО бот не стартує.
# Згенерувати: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Якщо ключ загубити або змінити — усі збережені API-ключі стануть непридатними.
SECRETS_KEY=
# Особистий Telegram id адміністратора (без нього адміна немає, міграція пропускається)
ADMIN_TELEGRAM_ID=
