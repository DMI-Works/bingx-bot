# BingX API Credentials (live)
BINGX_API_KEY=your_api_key_here
BINGX_API_SECRET=your_api_secret_here

# Опционально: отдельные ключи для testnet (VST). Если режим testnet включён
# (из Mini App или config), бот берёт эти ключи. Без них testnet откатывается
# на live-ключи, которые VST-эндпоинты не примут.
BINGX_API_KEY_TESTNET=
BINGX_API_SECRET_TESTNET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

WEBAPP_URL=https://your-webapp-url-here

MONGO_URI=mongo_uri_here
MONGO_DB_NAME=trading_bot
